# Python
__pycache__/
*.pyc
*.pyo
.venv/

# IDE
.idea/

# Claude Code local/machine-specific state (launch.json is shared, rest isn't)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Generated transcription output and ad-hoc debug artifacts.
# NOTE: `output/` is a CODE MODULE here (the Scribe Engraver), NOT a
# generated-output dir - do not ignore it. Jazz writes its MIDI/MusicXML
# to transcriptions/, which is ignored below.
debug/
transcriptions/

# Separated stem audio - regenerated by the Separation Engine on demand,
# hundreds of MB per song, and byte-reproducible from the source audio now
# that Demucs is seeded (separation_seed on PipelineResult).
stems/

# Input/ - the local TEST LIBRARY (tools/build_stem_cache.py): source songs
# plus their pre-separated stems, kept out of git. It's a convenience cache
# for stem-level analysis, not source - large audio, reproducible from the
# originals, and the pipeline never reads it (it always separates fresh).
# The stems inside are already covered by the `stems/` rule above; this also
# keeps the source audio and folder structure out of commits and pulls.
Input/

# Large full-codebase context dumps (not source, regenerated as needed)
grimlock_5.4.txt
grimlock_symphony5_5.txt
grimlock_refactor_context.md
code2prompt_jazz.md
